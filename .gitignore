# ---- secrets (never commit) ----
kaggle.json
.env
*.env
credentials.json
!research/raw/kaggle_facts.json

# ---- data (large, reproducible via scripts/download_data.py) ----
data/raw/
data/original/
data/*.csv
data/*.parquet
data/*.zip
!data/README.md
!data/MANIFEST.md

# ---- python env ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- heavy artifacts ----
#
# CRITICAL: every directory pattern here is ANCHORED with a leading slash.
# An unanchored `features/` or `models/` matches at ANY depth, which silently excluded
# src/features/ and src/models/ from the repository -- i.e. the whole feature-engineering and
# model layer was never committed and the repo could not reproduce the solution.
# Anchoring means "only at the repository root". `artifacts/features/` is still covered by the
# `artifacts/` rule. scripts/audit_untracked.py is the regression guard for this.
/artifacts/
/models/
/predictions/
/cache/
/features/
data/cache/
*.npy
*.npz
*.pkl
*.pt
*.pth
*.joblib
*.parquet
*.log

# ---- keep ledgers / reports / submissions ----
!experiments/**
!reports/**
!submissions/manifest.csv
!submissions/kaggle_submissions.csv
!submissions/*.csv
!STATUS.md
!research/**

# ---- misc ----
Thumbs.db
.DS_Store